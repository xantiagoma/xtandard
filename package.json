  "scripts": {
    "build": "vp pack && bun scripts/check-dist.ts && bun scripts/check-dist-types.ts",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:coverage:open": "vp test run --coverage && open coverage/index.html",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp lint && vp fmt --check && tsc --noEmit && bun run typecheck:ts7 && bun recs/generate.ts --check && sh scripts/brand-assets.sh --check",
    "typecheck:ts7": "node node_modules/typescript-v7/bin/tsc --noEmit",
    "docs:dev": "cd site && bun install && bun run dev",
    "docs:build": "cd site && bun install && bun run build",
    "docs:preview": "cd site && bun run preview",
    "brand:masters": "uv run scripts/brand/build.py",
    "brand:assets": "sh scripts/brand-assets.sh",
    "brand:check": "sh scripts/brand-assets.sh --check",
    "recs:check": "bun recs/check.ts",
    "recs:generate": "bun recs/generate.ts",
    "release": "changelogen --release --push --no-open",
    "prepare": "husky"
  },
